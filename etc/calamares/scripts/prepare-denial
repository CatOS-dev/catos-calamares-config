#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -euo pipefail

target=$(realpath -- "$1")
work=$(mktemp -d "$target/var/tmp/calamares-denial.XXXXXX")
trap 'rm -rf -- "$work"' EXIT
key="$work/repository.asc"
curl --fail --silent --show-error --location 'https://denialwm.github.io/denial/denial-repo-key.asc' -o "$key"
fingerprint=$(gpg --homedir "$work" --batch --show-keys --with-colons "$key" |
    awk -F: '$1 == "fpr" { print $10; exit }')
[[ "$fingerprint" == 'AE4108FA5E91E26BE0EE331E0F5B3AD16E023091' ]]
chroot "$target" pacman-key --init
chroot "$target" pacman-key --add "/var/tmp/${work##*/}/repository.asc"
chroot "$target" pacman-key --lsign-key "$fingerprint"

if ! chroot "$target" pacman-conf --repo-list | grep -Fxq denial; then
    cat >> "$target/etc/pacman.conf" <<'EOF'

[denial]
SigLevel = Required TrustedOnly
Server = https://denialwm.github.io/denial/$arch
EOF
fi

chroot "$target" pacman -Sy --noconfirm
