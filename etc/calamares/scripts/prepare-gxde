#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -euo pipefail

target=$(realpath -- "$1")
work=$(mktemp -d "$target/var/tmp/calamares-gxde.XXXXXX")
trap 'rm -rf -- "$work"' EXIT
key="$work/repository.asc"
curl --fail --silent --show-error --location 'https://repo.gxde.top/gxde-arch/gxde.asc' -o "$key"
fingerprint=$(gpg --homedir "$work" --batch --show-keys --with-colons "$key" |
    awk -F: '$1 == "fpr" { print $10; exit }')
[[ "$fingerprint" == 'BCC6D7F07130C0FA32669066FD6EEA1F20CD4B27' ]]
chroot "$target" pacman-key --init
chroot "$target" pacman-key --add "/var/tmp/${work##*/}/repository.asc"
chroot "$target" pacman-key --lsign-key "$fingerprint"

if ! chroot "$target" pacman-conf --repo-list | grep -Fxq gxde; then
    cat >> "$target/etc/pacman.conf" <<'EOF'

[gxde]
SigLevel = Required
Server = https://repo.gxde.top/gxde-arch/$arch
EOF
fi

chroot "$target" pacman -Sy --noconfirm
